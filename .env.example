# Neon (Dashboard del proyecto > Connection string > usa la que dice "pooled connection")
DATABASE_URL=postgresql://usuario:password@ep-xxxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# NextAuth — genera un valor random único con: openssl rand -base64 32
AUTH_SECRET=

# URL pública del sitio (la usa NextAuth para construir los links de login/callback)
NEXTAUTH_URL=http://localhost:3000

# Dominio(s) permitidos para crear cuenta, separados por coma (solo para el
# mensaje de ayuda en el formulario — la validación real vive en la tabla
# allowed_domains dentro de la base de datos)
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=fastdolphin.com

# Apollo.io (opcional por ahora — mientras no esté, la app usa datos de ejemplo)
APOLLO_API_KEY=

# Adzuna (opcional — capa gratis, solo requiere registrarse en
# https://developer.adzuna.com, sin tarjeta. Detecta vacantes REALES
# publicadas hoy por tecnología en EE.UU./Canadá — distinto a Apollo, que
# solo compara el perfil de la empresa. Mientras no estén las dos, esa
# fuente simplemente no aparece disponible en Configuración.)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Google Sign-In (opcional — mientras no estén las dos, el botón de Google
# simplemente no aparece y el login por correo/contraseña sigue igual)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=false

# Correos automáticos por señales de prioridad alta (opcional — capa gratis
# de Resend: https://resend.com, 100 correos/día). Mientras no haya
# RESEND_API_KEY, la app simplemente no manda correos.
RESEND_API_KEY=
# Remitente. Por defecto usa el dominio de pruebas de Resend para que
# funcione sin configurar nada más — para que salga como "@fastdolphin.com"
# hay que verificar ese dominio en Resend (necesita acceso al DNS del dominio).
EMAIL_FROM=
